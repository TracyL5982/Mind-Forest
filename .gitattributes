# Film clips (library/clips, built by library/tools/clips): videos and the atlas image in Git LFS.
library/clips/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
library/clips/*.jpg filter=lfs diff=lfs merge=lfs -text
# Museum works (library/works, built by library/tools/works): the pictures and the atlas in Git LFS.
library/works/full/*.heic filter=lfs diff=lfs merge=lfs -text
library/works/*.jpg filter=lfs diff=lfs merge=lfs -text
# The walkthrough demo (agents/demo): its pictures and its one film in Git LFS.
agents/demo/media/** filter=lfs diff=lfs merge=lfs -text
agents/demo/showcase/*/media/** filter=lfs diff=lfs merge=lfs -text
# Momo's lines for the demo's takes, recorded: 24 kHz PCM, one file per line.
agents/demo/voice/** filter=lfs diff=lfs merge=lfs -text
# Which voice each recording is in: a small text file the service reads, kept in git itself.
agents/demo/voice/*.json -filter -diff -merge text
