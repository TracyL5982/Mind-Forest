# The testing mode, while the team tests: no per-headset daily limits. `deploy/deploy.sh testing` deploys with these over fly.toml's;
# `deploy/deploy.sh` (or `deploy/deploy.sh judging`) deploys with fly.toml's judging limits again. 0 switches a limit off.
# Storage and file limits, the volume guard, read caps, public addresses only, calls in flight, device counts, the daily token
# budget, the spend alerts and the off switch stay on in both modes.
MIND_PALACE_LIMIT_VOICE_MINUTES=0
MIND_PALACE_LIMIT_SEARCHES=0
MIND_PALACE_LIMIT_WEB_ANSWERS=0
MIND_PALACE_LIMIT_DEVICE_DOLLARS=0
MIND_PALACE_LIMIT_DEVICE_TOKENS=0
