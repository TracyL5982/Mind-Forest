{
  "name": "mind-palace-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --no-warnings --import tsx src/node/main.ts",
    "test": "node --no-warnings --import tsx --test 'test/**/*.test.ts' 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "scenario": "node --no-warnings --import tsx scripts/scenario.ts",
    "dev:fake": "node --no-warnings --import tsx src/node/main.ts --fake"
  },
  "dependencies": {
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/ws": "^8.18.0",
    "playwright-core": "^1.65.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
